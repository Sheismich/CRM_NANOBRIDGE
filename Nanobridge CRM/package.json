{
  "name": "nanobridge-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the Nanobridge CRM and outbound automation.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/database/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mysql2": "^3.14.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
