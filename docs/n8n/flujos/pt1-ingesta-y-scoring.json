      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.first().json;\nconst clave = (v) => typeof v === \"string\" && v.trim() !== \"\" ? v.trim().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\") : undefined;\nreturn [{ json: {\n  id: d.prospecto_id,\n  prospecto: {\n    empresa: { nombreLegal: d.empresa_nombre, giro: clave(d.giro), tamano: d.tamano || undefined, region: d.region || undefined },\n    contacto: { nombre: d.contacto_nombre, correo: d.correo || undefined, telefono: d.telefono || undefined },\n    campana_id: d.campana_id || undefined\n  }\n} }];"
      }
    },
