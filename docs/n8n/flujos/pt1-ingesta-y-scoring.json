    {
      "id": "6b9dd4bd-aecb-4594-bb24-214e01aa85a7",
      "name": "Modo pruebas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        -640
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// Interruptor TEMPORAL de modo pruebas\n// ============================================================\nconst MODO_PRUEBAS = false;\nconst SANDBOX = false;\nconst PERMITIDOS = [\"<CORREO_PRUEBA_1>\", \"<CORREO_PRUEBA_2>\"];\n\nconst d = $('Preparar registro de scoring').first().json;\nconst prospecto_id = d.prospecto_id;\nconst correoRaw = d.prospecto && d.prospecto.contacto ? d.prospecto.contacto.correo : undefined;\nconst nombre = d.prospecto && d.prospecto.contacto ? d.prospecto.contacto.nombre : undefined;\nconst empresa = d.prospecto && d.prospecto.empresa ? d.prospecto.empresa.nombreLegal : undefined;\nconst giro = d.prospecto && d.prospecto.empresa ? d.prospecto.empresa.giro : undefined;\n\n// Normalizar correo: trim + minúsculas\nconst correo = typeof correoRaw === \"string\" ? correoRaw.trim().toLowerCase() : \"\";\n\n// Quitar la etiqueta \"+...\" del correo para comparar con PERMITIDOS\nconst quitarEtiqueta = (email) => {\n  if (!email || email.indexOf(\"@\") === -1) return email;\n  const partes = email.split(\"@\");\n  const local = partes[0].split(\"+\")[0];\n  return local + \"@\" + partes[1];\n};\n\nconst correoSinEtiqueta = quitarEtiqueta(correo);\nconst permitidosNorm = PERMITIDOS.map((e) => quitarEtiqueta(String(e).trim().toLowerCase()));\nconst permitido = permitidosNorm.indexOf(correoSinEtiqueta) !== -1;\n\nconst correoVacio = !correo || correo === \"\";\n\nlet enviar;\nlet motivo;\nif (correoVacio) {\n  enviar = false;\n  motivo = \"El prospecto no tiene correo\";\n} else if (MODO_PRUEBAS && !permitido) {\n  enviar = false;\n  motivo = \"Modo pruebas: destinatario fuera de la lista\";\n} else {\n  enviar = true;\n  motivo = null;\n}\n\nreturn [{\n  json: {\n    prospecto_id: prospecto_id,\n    correo: correo,\n    nombre: nombre,\n    empresa: empresa,\n    giro: giro || null,\n    sandbox: SANDBOX,\n    enviar: enviar,\n    motivo: motivo,\n    MODO_PRUEBAS: MODO_PRUEBAS,\n    PERMITIDOS: PERMITIDOS\n  }\n}];\n"
      }
    },
