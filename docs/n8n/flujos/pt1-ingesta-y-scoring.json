      ],
      "parameters": {
        "jsCode": "// Última revisión antes de PT1b: el destinatario que regresó POST /automatizacion/envios\n// debe estar en PERMITIDOS cuando MODO_PRUEBAS está encendido. El interruptor y la\n// lista se leen de \"Modo pruebas\" (un solo lugar). Compara igual que \"Modo pruebas\".\nconst mp = $('Modo pruebas').first().json;\nif (typeof mp.MODO_PRUEBAS !== \"boolean\" || !Array.isArray(mp.PERMITIDOS)) {\n  throw new Error(\"Revisar destinatario: falta MODO_PRUEBAS o PERMITIDOS en la salida de Modo pruebas\");\n}\n\nif (mp.MODO_PRUEBAS) {\n  const destinatarioRaw = $('HTTP Request5').first().json.destinatario;\n  const destinatario = typeof destinatarioRaw === \"string\" ? destinatarioRaw.trim().toLowerCase() : \"\";\n\n  const quitarEtiqueta = (email) => {\n    if (!email || email.indexOf(\"@\") === -1) return email;\n    const partes = email.split(\"@\");\n    const local = partes[0].split(\"+\")[0];\n    return local + \"@\" + partes[1];\n  };\n\n  const permitidosNorm = mp.PERMITIDOS.map((e) => quitarEtiqueta(String(e).trim().toLowerCase()));\n  const permitido = destinatario !== \"\" && permitidosNorm.indexOf(quitarEtiqueta(destinatario)) !== -1;\n\n  if (!permitido) {\n    throw new Error(\"Modo pruebas: destinatario fuera de la lista\");\n  }\n}\n\nreturn $input.all();\n"
      }
    },
