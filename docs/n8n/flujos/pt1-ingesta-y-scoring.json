    {
      "id": "fb718617-494f-4455-992c-87f4706fe379",
      "name": "combinar score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
        -848
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// Combinar score de reglas + score de IA (rama de éxito, E1 = No falló)\n// Pesos provisionales: 40% reglas, 60% IA — no están definidos en el plan,\n// ajustar si el equipo decide otra proporción.\n// ============================================================\n\nconst origen = $('preparar solicitud').first().json;\nconst p = origen.prospecto;\nconst prospectoId = origen.prospecto_id;\n\nconst PESO_REGLAS = 0.4;\nconst PESO_IA = 0.6;\n\nconst PUNTOS_TAMANO = { grande: 40, mediana: 30, pequena: 20, micro: 10 };\nconst PUNTOS_GIRO = { tecnologia: 30, manufactura: 25, logistica: 25, financiero: 20,\n  servicios: 20, salud: 15, construccion: 15, agroindustria: 15, comercio: 10,\n  educacion: 10, otro: 5 };\n\n\nlet scoreReglas = 0;\nscoreReglas += PUNTOS_TAMANO[p.empresa.tamano] || 0;\nscoreReglas += PUNTOS_GIRO[p.empresa.giro] || 0;\nif (p.contacto.correo)    scoreReglas += 10;\nif (p.contacto.telefono)  scoreReglas += 10;\nif (p.empresa.region)     scoreReglas += 10;\n\n\nconst scoreIa = $json.score_ia;\nconst confianza = $json.confianza;\nconst factoresIa = $json.factores_ia;\n\nconst scoreFinal = Math.round(scoreReglas * PESO_REGLAS + scoreIa * PESO_IA);\n\nlet prioridad;\nif (scoreFinal >= 70)      prioridad = \"alta\";\nelse if (scoreFinal >= 40) prioridad = \"media\";\nelse                       prioridad = \"baja\";\n\nreturn [{ json: { prospecto: p, prospecto_id: prospectoId,\n  scoring: { score_reglas: scoreReglas, score_ia: scoreIa, score_final: scoreFinal,\n    peso_reglas: PESO_REGLAS, peso_ia: PESO_IA, origen: \"reglas_ia\",\n    prioridad: prioridad, factores_ia: factoresIa,\n    motivo_solo_reglas: null, confianza: confianza,\n    execution_id: $execution.id } } }];\n"
      }
    },
    {
      "id": "352334ff-d55b-429b-8af0-ba74978fa373",
      "name": "Preparar registro de scoring",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2848,
        -640
      ],
      "parameters": {
        "jsCode": "const s = $json.scoring;\n\nlet confianza;\nif (s.confianza === null || s.confianza === undefined) {\n  confianza = undefined;\n} else if (s.confianza >= 0.8) {\n  confianza = \"alta\";\n} else if (s.confianza >= 0.5) {\n  confianza = \"media\";\n} else {\n  confianza = \"baja\";\n}\n\nconst metodo = s.origen === \"solo_reglas\" ? \"reglas\" : \"gemini\";\n\nreturn [{\n  json: {\n    prospecto: $json.prospecto,\n    prospecto_id: $json.prospecto_id,\n    scoring: s,\n    registro_scoring: {\n      execution_id: s.execution_id,\n      prospecto_id: $json.prospecto_id,\n      score: s.score_final,\n      prioridad: s.prioridad,\n      confianza: confianza,\n      metodo: metodo,\n      detalle: {\n        score_reglas: s.score_reglas,\n        score_ia: s.score_ia,\n        peso_reglas: s.peso_reglas,\n        peso_ia: s.peso_ia,\n        factores_ia: s.factores_ia,\n        motivo_solo_reglas: s.motivo_solo_reglas\n      }\n    }\n  }\n}];\n"
      }
    },
