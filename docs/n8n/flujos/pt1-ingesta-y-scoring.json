        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body_gemini }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "FDp0u0Lf6YjjqmuF",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "165bfbf7-2fb4-4519-9859-77a255bb9cbd",
      "name": "Parseo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2128,
        -832
      ],
      "parameters": {
        "jsCode": "const origen = $('preparar solicitud').first().json;\nconst p = origen.prospecto;\nconst prospectoId = origen.prospecto_id;\n\nlet ia_ok = false;\nlet score_ia = null;\nlet confianza = null;\nlet factoresIa = null;\n\ntry {\n  const textoRespuesta = $json.candidates[0].content.parts[0].text;\n  const parsed = JSON.parse(textoRespuesta);\n\n  if (\n    typeof parsed.score_ia === \"number\" &&\n    typeof parsed.confianza === \"number\" &&\n    parsed.factores && typeof parsed.factores === \"object\"\n  ) {\n    score_ia = parsed.score_ia;\n    confianza = parsed.confianza;\n    factoresIa = parsed.factores;\n    ia_ok = true;\n  }\n} catch (e) {\n  ia_ok = false;\n}\n\nreturn [{\n  json: {\n    prospecto: p,\n    prospecto_id: prospectoId,\n    ia_ok,\n    score_ia,\n    confianza,\n    factores_ia: factoresIa\n  }\n}];\n"
      }
    },
