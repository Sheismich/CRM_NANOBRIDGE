    {
      "id": "ebbd1f25-8f88-4913-86bd-2482653e94b8",
      "name": "scoring por reglas 5b",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        -320
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// Paso 5b — Scoring solo con reglas (fallback cuando la IA falla)\n// ============================================================\n\nconst origen = $('preparar solicitud').first().json;\nconst p = origen.prospecto;\nconst prospectoId = origen.prospecto_id;\n\nconst PUNTOS_TAMANO = { grande: 40, mediana: 30, pequena: 20, micro: 10 };\nconst PUNTOS_GIRO = { tecnologia: 30, manufactura: 25, logistica: 25, financiero: 20,\n  servicios: 20, salud: 15, construccion: 15, agroindustria: 15, comercio: 10,\n  educacion: 10, otro: 5 };\n\nlet score = 0;\nscore += PUNTOS_TAMANO[p.empresa.tamano] || 0;\nscore += PUNTOS_GIRO[p.empresa.giro] || 0;\nif (p.contacto.correo)    score += 10;\nif (p.contacto.telefono)  score += 10;\nif (p.empresa.region)     score += 10;\n\nlet prioridad;\nif (score >= 70)      prioridad = \"alta\";\nelse if (score >= 40) prioridad = \"media\";\nelse                  prioridad = \"baja\";\n\nreturn [{ json: { prospecto: p, prospecto_id: prospectoId,\n  scoring: { score_reglas: score, score_ia: null, score_final: score,\n    peso_reglas: 1.000, peso_ia: 0.000, origen: \"solo_reglas\",\n    prioridad: prioridad, factores_ia: null,\n    motivo_solo_reglas: $('HTTP Request2').isExecuted ? \"Fallo del servicio de IA tras agotar reintentos\" : \"La IA respondió con un formato no válido\",\n    confianza: null,\n    execution_id: $execution.id } } }];\n"
      }
    },
