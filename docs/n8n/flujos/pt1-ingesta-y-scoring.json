    {
      "id": "7dc5821d-2050-43d4-9429-3c4b4fb8743c",
      "name": "preparar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -832
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// Paso 5 — Preparar solicitud para Gemini\n// ⚠️ FASE 7: NUNCA mandar correo, teléfono ni descripción libre\n// prospecto viene del nodo 3 (validacion de Formato) directo --\n// upsert prospectos (nodo 5) ya es HTTP real, su salida es la\n// respuesta de la API, no el prospecto.\n// ============================================================\n\nconst p = $('Datos del prospecto').first().json.prospecto;\nconst prospectoId = $json.id;\n\nconst datosParaIA = {\n  giro: p.empresa.giro,\n  tamano: p.empresa.tamano,\n  region: p.empresa.region || null\n};\n\nconst instruccion = `Eres un asistente de calificación de leads B2B.\nCon base en estos datos de una empresa prospecto, calcula un score de 0 a 100\ny explica los factores que lo justifican.\n\nDatos: ${JSON.stringify(datosParaIA)}`;\n\nreturn [{\n  json: {\n    prospecto: p,\n    prospecto_id: prospectoId,\n    intento_gemini: 1,\n    datos_enviados_ia: datosParaIA,\n    body_gemini: {\n      contents: [{ parts: [{ text: instruccion }] }],\n      generationConfig: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: \"OBJECT\",\n          properties: {\n            score_ia:  { type: \"NUMBER\" },\n            confianza: { type: \"NUMBER\" },\n            factores:  {\n              type: \"OBJECT\",\n              properties: {\n                giro:   { type: \"STRING\" },\n                tamano: { type: \"STRING\" }\n              }\n            }\n          },\n          required: [\"score_ia\", \"confianza\", \"factores\"]\n        }\n      }\n    }\n  }\n}];\n\n"
      }
    },
    {
      "id": "60e79988-49be-4106-a4dd-c807cd0de4af",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1552,
        -752
      ],
