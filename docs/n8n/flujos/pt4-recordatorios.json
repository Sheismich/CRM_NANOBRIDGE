        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"execution_id\": \"recordatorio-{{ $json.envio_id }}\",\n  \"prospecto_id\": {{ $json.prospecto_id }},\n  \"canal\": \"correo\"\n}",
        "options": {
