        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"execution_id\": \"inactivo-{{ $json.envio_id }}\",\n  \"prospecto_id\": {{ $json.prospecto_id }},\n  \"estado\": \"inactivo\",\n  \"motivo\": \"Tres contactos sin respuesta\"\n}",
