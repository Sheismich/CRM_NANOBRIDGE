    {
      "id": "7cad964e-2ba7-4b85-81e7-9af309399397",
      "name": "Revisar destinatario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        528
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Última revisión antes de PT1b: el destinatario que regresó POST /automatizacion/envios\n// debe estar en PERMITIDOS cuando MODO_PRUEBAS está encendido. El interruptor y la\n// lista se leen de \"Modo pruebas\" (un solo lugar). Compara igual que \"Modo pruebas\".\nconst mp = $('Modo pruebas').item.json;\nif (typeof mp.MODO_PRUEBAS !== \"boolean\" || !Array.isArray(mp.PERMITIDOS)) {\n  throw new Error(\"Revisar destinatario: falta MODO_PRUEBAS o PERMITIDOS en la salida de Modo pruebas\");\n}\n\nif (mp.MODO_PRUEBAS) {\n  const r = $('Registrar envío').item.json;\n  const destinatario = ((r.body && r.body.destinatario) ?? \"\").trim().toLowerCase();\n  const [usuario, dominio] = destinatario.split(\"@\");\n  const sinEtiqueta = usuario && dominio ? usuario.split(\"+\")[0] + \"@\" + dominio : \"\";\n  const permitido = mp.PERMITIDOS.map((c) => c.trim().toLowerCase()).includes(sinEtiqueta);\n\n  if (!permitido) {\n    throw new Error(\"Modo pruebas: destinatario fuera de la lista\");\n  }\n}\n\nreturn { json: $json };\n"
      }
    },
