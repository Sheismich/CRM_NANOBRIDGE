    {
      "id": "273f72ab-1dee-4c05-aff8-a73fe2f2812f",
      "name": "Revisar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        816
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 201 = registrado: se manda. 200 = ya_existia: este recordatorio ya se\n// registró antes, NO se vuelve a mandar (preferimos perder uno a mandar\n// uno doble). 409 = la API no lo permite (ventana activa, supresión): no\n// se manda. Cualquier otro status es error real -> Error Workflow.\nconst r = $json;\nconst f = $('Modo pruebas').item.json;\nif (r.statusCode === 200) return { json: { ...f, enviar: false, motivo: \"ya_existia: no se vuelve a mandar\" } };\nif (r.statusCode === 409) return { json: { ...f, enviar: false, motivo: `409: ${r.body?.message ?? \"\"}` } };\nif (r.statusCode !== 201) throw new Error(`Registrar envío respondió ${r.statusCode}: ${JSON.stringify(r.body)}`);\nreturn { json: {\n  prospecto_id: f.prospecto_id, correo: r.body.destinatario, nombre: f.contacto_nombre,\n  empresa: f.empresa_nombre, giro: f.giro, sandbox: f.sandbox,\n  envio_id: r.body.id, numero_contacto: r.body.numero_contacto, reply_to: r.body.reply_to,\n  correo_contenido: r.body.correo,\n  enviar: true, motivo: null\n} };\n"
      }
    },
    {
      "id": "c7e1c6c5-919e-40e4-a48c-1f47b6b8c70a",
      "name": "¿Registrado?",
