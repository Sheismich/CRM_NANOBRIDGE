    {
      "id": "6d66ba9c-4b6d-40fd-85b1-a543430c554f",
      "name": "Modo pruebas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        720
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// MODO PRUEBAS (igual que en PT1). Solo se manda a PERMITIDOS\n// (y sus variantes con +). Se apaga al encender.\n// SANDBOX = true: SendGrid acepta el correo pero NO lo entrega.\n// ============================================================\nconst MODO_PRUEBAS = false;\nconst SANDBOX = false;\nconst PERMITIDOS = [\"<CORREO_PRUEBA_1>\"];\n\nreturn $input.all().map(({ json: f }) => {\n  const correo = (f.correo ?? \"\").trim().toLowerCase();\n  const [usuario, dominio] = correo.split(\"@\");\n  const sinEtiqueta = usuario && dominio ? `${usuario.split(\"+\")[0]}@${dominio}` : \"\";\n  const permitido = PERMITIDOS.map((c) => c.trim().toLowerCase()).includes(sinEtiqueta);\n\n  let motivo = null;\n  if (correo === \"\") motivo = \"Sin correo\";\n  else if (f.campana_activa === false) motivo = \"Campaña inactiva\";\n  else if (f.campana_id === null && !MODO_PRUEBAS) motivo = \"Sin campaña\";\n  else if (MODO_PRUEBAS && !permitido) motivo = \"Modo pruebas: destinatario fuera de la lista\";\n\n  return { json: { ...f, correo, sandbox: SANDBOX, enviar: motivo === null, motivo, MODO_PRUEBAS, PERMITIDOS } };\n});\n"
      }
    },
