    {
      "parameters": {
        "jsCode": "const entrada = $('Cuando lo llama otro flujo').first().json;\nconst base = $('Armar correo SendGrid').first().json;\nconst resp = $('SendGrid · enviar').first().json;\nconst confirmacion = items[0].json;\n\nconst headers = resp.headers || {};\nconst messageId = headers[\"x-message-id\"] || null;\n\nreturn [{\n  json: {\n    prospecto_id: entrada.prospecto_id,\n    envio_id: entrada.envio_id,\n    destinatario: entrada.correo,\n    sandbox: base.sandbox,\n    sendgrid_status: resp.statusCode,\n    sendgrid_message_id: messageId,\n    proveedor_id: messageId,\n    confirmacion: confirmacion\n  }\n}];\n"
      },
