    {
      "parameters": {
        "jsCode": "const FROM_EMAIL = \"hola@contacto.nano-bridge-mex.com\";\nconst FROM_NAME = \"NANOBRIDGE\";\n\nconst d = items[0].json;\n\nconst reply_to = d.reply_to;\nconst correo = d.correo;\nconst nombre = d.nombre;\nconst empresa = d.empresa;\nconst giro = d.giro;\nconst numero_contacto = d.numero_contacto;\n\nif (!reply_to || typeof reply_to !== \"string\" || !reply_to.startsWith(\"r+\")) {\n  throw new Error(\"Falta el reply_to firmado que devuelve POST /envios\");\n}\n\nif (!correo || typeof correo !== \"string\" || correo.trim() === \"\") {\n  throw new Error(\"El prospecto no tiene correo\");\n}\n\nconst sandbox = d.sandbox === false ? false : true;\n\nconst c = d.correo_contenido;\nif (!c || !c.asunto || !c.texto || !c.html) {\n  throw new Error('Falta el correo armado por la API (campo correo de POST /envios)');\n}\n\n// Destinatario: omitir name si viene vacío\nconst to = { email: correo };\nif (nombre && String(nombre).trim() !== \"\") {\n  to.name = nombre;\n}\n\nconst sendgrid = {\n  personalizations: [\n    {\n      to: [to],\n      custom_args: {\n        prospecto_id: String(d.prospecto_id),\n        envio_id: String(d.envio_id)\n      }\n    }\n  ],\n  custom_args: { prospecto_id: String(d.prospecto_id), envio_id: String(d.envio_id) },\n  from: { email: FROM_EMAIL, name: FROM_NAME },\n  reply_to: { email: reply_to },\n  subject: c.asunto,\n  content: [\n    { type: \"text/plain\", value: c.texto },\n    { type: \"text/html\", value: c.html }\n  ],\n  tracking_settings: { subscription_tracking: { enable: false }, click_tracking: { enable: false, enable_text: false }, open_tracking: { enable: false } },\n  mail_settings: { sandbox_mode: { enable: sandbox } }\n};\n\nreturn [{\n  json: {\n    prospecto_id: d.prospecto_id,\n    envio_id: d.envio_id,\n    sandbox: sandbox,\n    sendgrid: sendgrid\n  }\n}];\n"
      },
