              "type": "string",
              "value": "={{ (() => { const e = $json.error; let m; if (typeof e === 'string') { m = e; } else if (e && e.message) { m = e.description ? e.message + ': ' + e.description : e.message; } else { m = JSON.stringify(e || $json); } return ('SendGrid falló: ' + String(m)).slice(0, 300); })() }}"
