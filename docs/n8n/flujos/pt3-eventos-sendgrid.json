    {
      "id": "7b7b661b-a10a-4d5c-a750-98c1b587e2da",
      "name": "Revisar respuestas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        144
      ],
      "parameters": {
        "jsCode": "const todas = $input.all();\nconst malas = todas.filter(i => ![200, 201, 409].includes(i.json.statusCode));\nif (malas.length > 0) {\n  throw new Error('La API rechazó ' + malas.length + ' supresión(es): ' + JSON.stringify(malas.slice(0, 3).map(i => ({ status: i.json.statusCode, body: i.json.body }))));\n}\nreturn [{ json: { registradas: todas.length } }];"
      }
    },
