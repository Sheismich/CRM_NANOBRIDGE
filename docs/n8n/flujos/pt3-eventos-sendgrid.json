    {
      "id": "4ff90880-609d-40dd-8b29-970aa244e0e6",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst SENDGRID_PUBLIC_KEY = \"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEg5aRNhh+DLFC74CeyxiF5lebBiWTtEJi90NBoTq6tXJ0Ef3C47UZPertiAyYXwbPhITVpmIFF+mjIVxYYoCmng==\";\nconst item = $input.first();\nconst h = item.json.headers || {};\nconst firma = h['x-twilio-email-event-webhook-signature'] || '';\nconst ts = h['x-twilio-email-event-webhook-timestamp'] || '';\nconst crudo = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nlet valida = false;\ntry {\n  const pem = '-----BEGIN PUBLIC KEY-----\\n' + SENDGRID_PUBLIC_KEY + '\\n-----END PUBLIC KEY-----';\n  valida = crypto.createVerify('sha256').update(ts + crudo).verify(pem, firma, 'base64');\n} catch (e) { valida = false; }\nlet eventos = [];\ntry { eventos = JSON.parse(crudo); } catch (e) {}\nreturn [{ json: { firma_valida: valida, eventos: Array.isArray(eventos) ? eventos : [] } }];"
      }
    },
    {
      "id": "50224c1e-7307-491c-93fb-de473a9afd91",
      "name": "¿Firma válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "firma-valida-cond",
              "leftValue": "={{ $json.firma_valida }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9dbab5d8-3a91-4bbc-89ff-933840046b6d",
      "name": "Elegir eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        384
      ],
      "parameters": {
        "jsCode": "const eventos = $input.first().json.eventos || [];\nconst supresiones = [];\nfor (const e of eventos) {\n  let motivo = null;\n  if (e.event === 'unsubscribe' || e.event === 'group_unsubscribe') motivo = 'Baja por link de SendGrid';\n  else if (e.event === 'spamreport') motivo = 'Queja de spam en SendGrid';\n  else if (e.event === 'bounce' && e.type === 'bounce') motivo = 'Rebote definitivo: ' + String(e.reason || '').slice(0, 150);\n  if (!motivo || !e.email || !e.sg_event_id) continue;\n  if (!e.event) throw new Error(\"Evento sin nombre: \" + JSON.stringify(e));\n  if (e.envio_id) motivo += ' (envío ' + e.envio_id + ')';\n  supresiones.push({ execution_id: 'sg-' + e.sg_event_id, tipo: 'correo', valor: e.email, motivo: motivo.slice(0, 255), evento: e.event });\n}\nreturn [{ json: { supresiones } }];"
      }
    },
    {
      "id": "594d3c00-17e2-4cde-a30c-0093db2eefcb",
      "name": "¿Hay supresiones?",
