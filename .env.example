NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://crm_user:change_me@127.0.0.1:3306/nanobridge_crm
SESSION_COOKIE_NAME=nanobridge_session
SESSION_TTL_HOURS=12
# Orígenes del frontend permitidos para CORS, separados por coma (ej.
# https://app.nanobridge.com,http://localhost:5173). Vacío = CORS
# deshabilitado (n8n y curl no se ven afectados, solo peticiones de
# navegador).
CORS_ORIGINS=
# En 'true' solo si la API corre detrás de un proxy real (nginx, balanceador
# de carga, etc.) que agrega X-Forwarded-For -- de lo contrario RateLimitGuard
# ve la IP del proxy para todo el tráfico y el límite por IP se vuelve global.
TRUST_PROXY=false
CRM_CALLBACK_API_KEY=replace_before_deploying
WEBHOOK_ENTRADA_API_KEY=replace_before_deploying
# Despachador de eventos_pendientes (patrón outbox): URL del webhook de n8n
# que recibe los eventos salientes. Sin configurar, los eventos agotan sus
# reintentos y quedan en procesos_fallidos.
N8N_WEBHOOK_URL=
OUTBOX_DISPATCH_INTERVAL_MS=15000
# Expediente documental (PLAN_CRM_DEFINITIVO.md #8). 'local' (default) guarda
# los archivos en disco y no requiere un bucket real; 'gcs' usa
# @google-cloud/storage contra un bucket privado (requiere GCS_BUCKET +
# credenciales del SDK de Google).
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_LOCAL_DIR=./storage
# Firma del Reply-To de cada correo (r+<envio_id>.<firma>@REPLY_TO_DOMAIN).
# Mínimo 32 caracteres, distinto de los demás secretos. Rotarlo invalida los
# Reply-To ya enviados.
REPLY_TO_SIGNING_SECRET=replace_before_deploying_with_32_chars_min
REPLY_TO_DOMAIN=respuestas.contacto.nano-bridge-mex.com
# Solo si STORAGE_DRIVER=gcs:
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=
# Integraciones que la API llama directo (src/integraciones/). Con "falso" no
# sale nada a internet (desarrollo y pruebas). En producción:
# CORREO_DRIVER=sendgrid + SENDGRID_API_KEY (secreto, llave solo Mail Send).
CORREO_DRIVER=falso
SENDGRID_API_KEY=
CORREO_REMITENTE=hola@contacto.nano-bridge-mex.com
CORREO_REMITENTE_NOMBRE=CRM NANOBRIDGE
# Liga del CRM para los botones de los correos de aviso.
CRM_URL=https://crm-prospeccion-outbound.web.app
# Gemini (etapas 3 y 4): IA_DRIVER=gemini + GEMINI_API_KEY del proyecto de pago.
IA_DRIVER=falso
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
