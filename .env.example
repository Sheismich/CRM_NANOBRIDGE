NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://crm_user:change_me@127.0.0.1:3306/nanobridge_crm
SESSION_COOKIE_NAME=nanobridge_session
SESSION_TTL_HOURS=12
CRM_CALLBACK_API_KEY=replace_before_deploying
WEBHOOK_ENTRADA_API_KEY=replace_before_deploying
# Despachador de eventos_pendientes (patrón outbox): URL del webhook de n8n
# que recibe los eventos salientes. Sin configurar, los eventos agotan sus
# reintentos y quedan en procesos_fallidos.
N8N_WEBHOOK_URL=
OUTBOX_DISPATCH_INTERVAL_MS=15000
# Expediente documental (PLAN_CRM_DEFINITIVO.md #8). 'local' (default) guarda
# los archivos en disco y no requiere un bucket real; 'gcs' usa
# @google-cloud/storage contra un bucket privado (requiere GCS_BUCKET +
# credenciales del SDK de Google).
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_LOCAL_DIR=./storage
STORAGE_LOCAL_SIGNING_SECRET=replace_before_deploying
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Solo si STORAGE_DRIVER=gcs:
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=
